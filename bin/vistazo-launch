#!/usr/bin/python3 -I
# Starts one RomM game in RetroDECK. Steam runs this with a single argument: the game's number in
# RomM. Where its file is comes from a private list Vistazo's backend keeps beside this launcher,
# and the file goes to RetroDECK as one argument of its own: no file name ever reaches a shell or
# Steam's launch options.
#
# It stays alive while the game runs, so that whoever stops the game by signalling this launcher
# (Punktfunk, when a stream ends) reaches the emulator too: Steam starts it apart from the game's
# own processes, and a signal sent here is passed on to it (see forward).
import json
import os
import signal
import stat
import subprocess
import sys

RETRODECK = "net.retrodeck.retrodeck"
# How long the save is waited for: a little longer than Vistazo RomM takes at most (LAUNCH_WAIT).
WAIT = 30


def fail(why):
    sys.stderr.write("vistazo-launch: %s\n" % why)
    return 2


def game_path(table_file, rom_id):
    """(the file of that game, the emulator chosen for it or None), or (None, the reason)."""
    if not (rom_id.isascii() and rom_id.isdigit() and len(rom_id) <= 12):
        return None, "not a game number"
    try:
        info = os.lstat(table_file)
        # Only a plain file of this user that nobody else can write is believed.
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
            return None, "the game list is not private"
        with open(table_file, encoding="utf-8") as f:
            table = json.load(f)
    except (OSError, ValueError):
        return None, "no game list"
    entry = table.get(rom_id) if isinstance(table, dict) else None
    emulator = None
    folder = None
    if isinstance(entry, dict):
        # The game's folder, when a disc of it was chosen: the disc must lie inside it.
        folder = entry.get("folder", None)
        # RetroDECK's own command for the emulator chosen for this game.
        emulator = entry.get("emulator")
        if (emulator is not None or folder is None) and (
                not isinstance(emulator, str) or not emulator or "\0" in emulator or "\n" in emulator or len(emulator) > 1000):
            return None, "the emulator chosen is not one RetroDECK has"
        entry = entry.get("path")
    path = entry
    if not isinstance(path, str) or not os.path.isabs(path) or "\0" in path:
        return None, "game not installed"
    if folder is not None:
        if not isinstance(folder, str) or not os.path.isabs(folder) or "\0" in folder:
            return None, "the disc chosen is not in the game's folder"
        if not os.path.realpath(path).startswith(os.path.realpath(folder) + os.sep):
            return None, "the disc chosen is not in the game's folder"
    if not os.path.isfile(path):
        return None, "the game's file is gone"
    return (path, emulator), None


def save_in_step(here, rom_id):
    """Asks Vistazo RomM, when it is running, to bring the game's save in step with RomM before
    the emulator opens it (another device may have played since), and waits for its answer. Any
    trouble, or no answer in time, and the game starts as it is: Vistazo says so on screen."""
    import socket
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(2)
            s.connect(os.path.join(here, "launch.sock"))
            s.sendall(rom_id.encode("ascii") + b"\n")
            s.settimeout(WAIT)
            while s.recv(64):
                pass
    except (OSError, ValueError):
        pass


def leaves(root):
    """The processes under root (root itself if it has none yet) that have no children of their
    own, as (pid, its start time) so that a number reused later is never taken for them."""
    children = {}
    started = {}
    try:
        names = os.listdir("/proc")
    except OSError:
        return []
    for name in names:
        if not name.isdigit():
            continue
        try:
            with open("/proc/%s/stat" % name, "rb") as f:
                fields = f.read().rsplit(b")", 1)[1].split()
        except (OSError, IndexError):
            continue  # gone meanwhile
        pid = int(name)
        children.setdefault(int(fields[1]), []).append(pid)
        started[pid] = fields[19]
    found = []
    todo = [root]
    while todo:
        pid = todo.pop()
        below = children.get(pid, [])
        if below:
            todo.extend(below)
        elif pid in started:
            found.append((pid, started[pid]))
    return found


def forward(root, sent):
    """Asks the emulator under root to stop the way closing it would: SIGTERM, which Dolphin and
    the others take as "stop", saving as they close. Only the processes at the bottom of the tree
    get it, the emulator: the scripts and the sandbox above it end once it has, and stopping them
    first could take the emulator down before it saved. Each process gets it once: a second one
    makes Dolphin quit at once. Nothing is killed outright; that is for whoever sent the signal."""
    for leaf in leaves(root):
        if leaf in sent:
            continue
        sent.add(leaf)
        try:
            os.kill(leaf[0], signal.SIGTERM)
        except OSError:
            pass


def main(argv):
    if len(argv) != 2:
        return fail("expected one game number")
    here = os.path.dirname(os.path.realpath(__file__))
    found, why = game_path(os.path.join(here, "launch.json"), argv[1])
    if found is None:
        return fail(why)
    path, emulator = found
    save_in_step(here, argv[1])

    stopping = []  # the stop signals received, in order

    def on_signal(number, frame):
        stopping.append(number)

    for number in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        if signal.getsignal(number) != signal.SIG_IGN:  # one ignored stays so, for the emulator too
            signal.signal(number, on_signal)
    if stopping:  # asked to stop while the save was being put in step: the game is not started
        return 128 + stopping[0]
    try:
        # Every descriptor Steam left open is passed on, as when this launcher was replaced by it.
        child = subprocess.Popen(["flatpak", "run", RETRODECK] + (["-e", emulator] if emulator else []) + [path],
                                 close_fds=False)
    except OSError as e:
        return fail("flatpak did not start: %s" % e)
    sent = set()
    handled = 0
    while True:
        try:
            code = child.wait(timeout=0.2)
            break
        except subprocess.TimeoutExpired:
            pass
        if len(stopping) > handled:
            handled = len(stopping)
            forward(child.pid, sent)
    return code if code >= 0 else 128 - code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
